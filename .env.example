# Copy to .env.local and fill in values.
# cp .env.example .env.local

DATA_MODE=live

# Firebase client (Firebase console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_ID=tvm-investments

# Firebase Admin (service account JSON fields)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Admin bootstrap
NEXT_PUBLIC_TVM_ADMIN_EMAIL=admin@tvm-investments.test
TVM_ADMIN_PASSWORD=

# Discord OAuth (localhost — Discord Developer Portal → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/discord/callback
# Production (Vercel): https://tvminvest.com/api/discord/callback
# Optional auto-join to your server (Bot tab + guilds.join scope)
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
DISCORD_OAUTH_SECRET=

# Stripe, cron, email, etc. — see README.md
