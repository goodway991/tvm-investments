# Data mode: "demo" uses bundled sample data; "live" calls external APIs
DATA_MODE=demo

# Finnhub (free tier: https://finnhub.io/register)
FINNHUB_API_KEY=

# Alpha Vantage (free tier: https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=

# OpenAI — news classification (strategy #1)
OPENAI_API_KEY=

# Firebase client (from Firebase Console → Project settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_ID=tvm-investments
NEXT_PUBLIC_TVM_ADMIN_EMAIL=admin@tvm-investments.test

# Firebase Admin (for server-side writes / cron)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Vercel Cron secret (optional, protects /api/cron/daily-snapshot)
CRON_SECRET=
