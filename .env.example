# Data mode: "live" pulls Yahoo Finance quotes, daily bars, and news after the
# weekday close. Set DATA_MODE=demo only for offline UI work with sample data.
# Production must stay on live so numbers, charts, and sector notes refresh daily.
DATA_MODE=live

# LLM keys (Gemini / OpenAI / Codex): news classification, culture write-ups,
# and short-term forecast notes. They cannot fetch quotes, charts, or a stock
# universe. Live prices come from Yahoo Finance + the free NASDAQ screener.

# Finnhub (optional extra headlines): https://finnhub.io/register
FINNHUB_API_KEY=

# Alpha Vantage (optional; free tier is very small ~25 calls/day)
ALPHA_VANTAGE_API_KEY=

# Gemini (free tier) — news classification for strategy #1
# Create a key at https://aistudio.google.com/apikey (no credit card)
GEMINI_API_KEY=

# OpenAI — optional paid fallback if you prefer GPT instead of Gemini
OPENAI_API_KEY=

# Firebase client (from Firebase Console → Project settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_ID=tvm-investments
# GA4 measurement ID from the Firebase-linked Analytics property
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-2J13NVBB71
NEXT_PUBLIC_TVM_ADMIN_EMAIL=admin@tvm-investments.test

# Firebase Admin (for server-side writes / cron)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Required in production. Protects /api/cron/daily-snapshot
CRON_SECRET=

# Stripe (server-only secret. Publishable key is the pk_ test/live key.)
# Never NEXT_PUBLIC_ the secret. Create Products/Prices in the Dashboard or
# `npx tsx scripts/setup-stripe-catalog.ts`.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional. Signing secret from `stripe listen` on localhost.
STRIPE_WEBHOOK_SECRET_LOCAL=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ULTRA_MONTHLY=
STRIPE_PRICE_ULTRA_YEARLY=
STRIPE_PORTAL_CONFIGURATION=
STRIPE_PORTAL_CONFIGURATION_LABS=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Decrypts the Settings feedback inbox. Never put the inbox
# address in NEXT_PUBLIC_* — that would publish it in the browser bundle.
TVM_FEEDBACK_UNLOCK=
# Optional override for the encrypted inbox (Workspace address later).
TVM_CONTACT_EMAIL=
NEXT_PUBLIC_TVM_CONTACT_EMAIL=
# Optional. When set, feedback is emailed via Resend (preferred).
RESEND_API_KEY=
# Optional. Verified Resend From once the domain exists.
TVM_FEEDBACK_FROM=
# Optional SMTP (Gmail app password). Used to deliver Settings notes.
# FormSubmit cannot be used from Vercel (Cloudflare blocks it).
TVM_SMTP_HOST=
TVM_SMTP_PORT=
TVM_SMTP_USER=
TVM_SMTP_PASS=
