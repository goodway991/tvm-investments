# Data mode: "live" pulls Yahoo Finance quotes, daily bars, and news after the
# weekday close. Set DATA_MODE=demo only for offline UI work with sample data.
# Production must stay on live so numbers, charts, and sector notes refresh daily.
DATA_MODE=live

# LLM keys (Gemini / OpenAI / Codex): news classification, culture write-ups,
# and short-term forecast notes. They cannot fetch quotes, charts, or a stock
# universe. Live prices come from Yahoo Finance + the free NASDAQ screener.

# Finnhub (optional extra headlines): https://finnhub.io/register
FINNHUB_API_KEY=

# Alpha Vantage (optional; free tier is very small ~25 calls/day)
ALPHA_VANTAGE_API_KEY=

# Gemini (free tier) — news classification for strategy #1
# Create a key at https://aistudio.google.com/apikey (no credit card)
GEMINI_API_KEY=

# OpenAI — optional paid fallback if you prefer GPT instead of Gemini
OPENAI_API_KEY=

# Firebase client (from Firebase Console → Project settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_ID=tvm-investments
NEXT_PUBLIC_TVM_ADMIN_EMAIL=admin@tvm-investments.test

# Firebase Admin (for server-side writes / cron)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Required in production. Protects /api/cron/daily-snapshot
CRON_SECRET=

# Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Shared inbox for Stripe Link + Settings feedback (create this later)
TVM_CONTACT_EMAIL=
NEXT_PUBLIC_TVM_CONTACT_EMAIL=
# Optional. When set with TVM_CONTACT_EMAIL, feedback is emailed via Resend.
RESEND_API_KEY=
