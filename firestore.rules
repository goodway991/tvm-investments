rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed data model
    // ===============================================================
    // users/{uid}
    //   uid: string, email: string, displayName: string
    //   firstName, lastName (required on new client signups)
    //   tourCompletedAt: timestamp (set after the virtual tour)
    //   seenTour: string tour version, e.g. "tour-3" (re-shows when it changes)
    //   seenCustomize: string customize prompt version, e.g. "customize-1"
    //   newSeen: optional map of feature id -> "YYYY-MM-DD" first-seen day
    //     keys: bogen, portfolio, settings, density, appearance,
    //           horizon, workstation, pulse, sectors
    //     newSeenWave: "beta-3" | "tvm-1" — changing it lets first-seen dates reset
    //     (New badges hide 3 calendar days after first login that sees them)
    //   tosVersion, tosAcceptedAt, privacyAcceptedAt (required on create)
    //   createdAt: timestamp (immutable), updatedAt: timestamp
    //
    // api_usage/{uid}
    //   uid, date (YYYY-MM-DD ET), market, research, updatedAt
    //   Admin SDK only — daily counters for Yahoo/Gemini proxy limits
    //
    // entitlements/{uid}
    //   uid: string, role: "client"|"admin", plan: "free"|"pro"|"ultra"
    //   watchlistLimit: int, cooldownDays: int
    //   Complimentary Pro is role "client" + plan "pro" + source "comp"
    //   Paid plans are Admin SDK only: source "stripe", stripeCustomerId,
    //     stripeSubscriptionId, optional stripeCancelAtPeriodEnd /
    //     stripeAccessUntil. Clients cannot set role, plan, or source.
    //   createdAt: timestamp (immutable), updatedAt: timestamp
    //
    // watchlists/{uid}
    //   uid: string, symbols: list<string> (allowed market symbols only)
    //   changedAt: timestamp, nextChangeAt: timestamp
    //   createdAt: timestamp (immutable), updatedAt: timestamp
    //
    // portfolios/{uid}
    //   uid: string, cash: number, totalValue: number
    //   createdAt: timestamp (immutable), updatedAt: timestamp
    //
    // portfolios/{uid}/positions/{symbol}
    //   uid: string, symbol: string, shares: number
    //   averageCost: number, currentPrice: number, updatedAt: timestamp
    //   purchasedAt: optional "YYYY-MM-DD" buy date (or null)
    //
    // horizon_sims/{uid}
    //   uid: string, cash: number, totalValue: number
    //   createdAt: timestamp (immutable), updatedAt: timestamp
    //   create starts the paper book at cash == 10000, totalValue == 10000
    //
    // horizon_sims/{uid}/positions/{symbol}
    //   uid: string, symbol: string, shares: number
    //   averageCost: number, currentPrice: number, updatedAt: timestamp
    //
    // site/maintenance
    //   enabled: master lock. Dates only inform the banner copy.
    //   warning: orange banner while enabled or when warning is true
    //   public read, Admin SDK / console write only
    //
    // beta_status/{uid}
    //   waitlistStatus: "none"|"pending"|"admitted"
    //   betaTester, discordConnected
    //   Owner may read. Admin SDK only writes. Clients cannot admit themselves.
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isBootstrapAdmin() {
      return isAuthenticated()
        && request.auth.token.email == "admin@tvm-investments.test"
        && request.auth.token.firebase.sign_in_provider == "password";
    }

    function hasEntitlement(uid) {
      return exists(/databases/$(database)/documents/entitlements/$(uid));
    }

    function entitlement(uid) {
      return get(/databases/$(database)/documents/entitlements/$(uid)).data;
    }

    function isPaid(uid) {
      return hasEntitlement(uid)
        && (
          entitlement(uid).plan == "pro"
          || entitlement(uid).plan == "ultra"
        );
    }

    // Labs overlay gives admin Ultra (500). Firestore entitlements stay
    // plan "pro" / limit 100 so this cap is applied here, not on the doc.
    function effectiveWatchlistLimit(uid) {
      return isBootstrapAdmin()
          || (hasEntitlement(uid) && entitlement(uid).plan == "ultra")
        ? 500
        : entitlement(uid).watchlistLimit;
    }

    function validEmail(value) {
      return value is string
        && value.size() >= 5
        && value.size() <= 254
        && value.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$");
    }

    function validGivenName(value) {
      return value is string
        && value.size() >= 1
        && value.size() <= 40
        && value.matches("^[^@0-9]{1,40}$");
    }

    function validUser(data, uid) {
      return data.keys().hasOnly([
          "uid", "email", "displayName", "createdAt", "updatedAt",
          "tosVersion", "tosAcceptedAt", "privacyAcceptedAt",
          "firstName", "lastName", "tourCompletedAt", "seenRelease", "seenTour",
          "seenCustomize", "newSeen", "newSeenWave", "country", "timeZone"
        ])
        && data.keys().hasAll([
          "uid", "email", "displayName", "createdAt", "updatedAt"
        ])
        && data.uid is string
        && data.uid == uid
        && data.email == request.auth.token.email
        && validEmail(data.email)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 81
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (
          !data.keys().hasAny(["tosVersion", "tosAcceptedAt", "privacyAcceptedAt"])
          || (
            data.tosVersion is string
            && data.tosVersion.size() >= 8
            && data.tosVersion.size() <= 32
            && data.tosAcceptedAt is timestamp
            && data.privacyAcceptedAt is timestamp
          )
        )
        && (
          !data.keys().hasAny(["firstName", "lastName"])
          || (
            data.keys().hasAll(["firstName", "lastName"])
            && validGivenName(data.firstName)
            && validGivenName(data.lastName)
            && data.displayName == data.firstName + " " + data.lastName
          )
        )
        && (
          !data.keys().hasAny(["tourCompletedAt"])
          || data.tourCompletedAt is timestamp
        )
        && (
          !data.keys().hasAny(["seenRelease"])
          || (
            data.seenRelease is string
            && data.seenRelease.size() >= 1
            && data.seenRelease.size() <= 32
          )
        )
        && (
          !data.keys().hasAny(["seenTour"])
          || (
            data.seenTour is string
            && data.seenTour.size() >= 1
            && data.seenTour.size() <= 32
          )
        )
        && (
          !data.keys().hasAny(["seenCustomize"])
          || (
            data.seenCustomize is string
            && data.seenCustomize.size() >= 1
            && data.seenCustomize.size() <= 32
          )
        )
        && (
          !data.keys().hasAny(["newSeen"])
          || validNewSeen(data.newSeen)
        )
        && (
          !data.keys().hasAny(["newSeenWave"])
          || (
            data.newSeenWave is string
            && data.newSeenWave.size() >= 1
            && data.newSeenWave.size() <= 16
          )
        )
        && (
          !data.keys().hasAny(["country"])
          || (
            data.country is string
            && data.country.size() == 2
            && data.country.matches("^[A-Z]{2}$")
          )
        )
        && (
          !data.keys().hasAny(["timeZone"])
          || (
            data.timeZone is string
            && data.timeZone.size() >= 3
            && data.timeZone.size() <= 64
          )
        );
    }

    function validDayStamp(value) {
      return value is string
        && value.size() == 10
        && value.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$");
    }

    function validNewSeenStamp(map, key) {
      return !map.keys().hasAny([key]) || validDayStamp(map[key]);
    }

    function validNewSeen(value) {
      return value is map
        && value.size() <= 24
        && value.keys().hasOnly([
          "bogen", "portfolio", "settings", "density", "appearance",
          "horizon", "workstation", "pulse", "sectors"
        ])
        && validNewSeenStamp(value, "bogen")
        && validNewSeenStamp(value, "portfolio")
        && validNewSeenStamp(value, "settings")
        && validNewSeenStamp(value, "density")
        && validNewSeenStamp(value, "appearance")
        && validNewSeenStamp(value, "horizon")
        && validNewSeenStamp(value, "workstation")
        && validNewSeenStamp(value, "pulse")
        && validNewSeenStamp(value, "sectors");
    }

    function newSeenKeyFrozen(prior, next, key) {
      return !prior.keys().hasAny([key])
        || (
          next.keys().hasAny([key])
          && next[key] == prior[key]
        );
    }

    function newSeenWaveAdvanced(prior, next) {
      return !prior.keys().hasAny(["newSeenWave"])
        || !next.keys().hasAny(["newSeenWave"])
        || next.newSeenWave != prior.newSeenWave;
    }

    function newSeenFrozen(prior, next) {
      return newSeenWaveAdvanced(prior, next)
        || !prior.keys().hasAny(["newSeen"])
        || (
          next.keys().hasAny(["newSeen"])
          && newSeenKeyFrozen(prior.newSeen, next.newSeen, "bogen")
          && newSeenKeyFrozen(prior.newSeen, next.newSeen, "portfolio")
          && newSeenKeyFrozen(prior.newSeen, next.newSeen, "settings")
          && newSeenKeyFrozen(prior.newSeen, next.newSeen, "density")
          && newSeenKeyFrozen(prior.newSeen, next.newSeen, "appearance")
          && newSeenKeyFrozen(prior.newSeen, next.newSeen, "horizon")
          && newSeenKeyFrozen(prior.newSeen, next.newSeen, "workstation")
          && newSeenKeyFrozen(prior.newSeen, next.newSeen, "pulse")
          && newSeenKeyFrozen(prior.newSeen, next.newSeen, "sectors")
        );
    }

    function validFreeEntitlement(data, uid) {
      return data.keys().hasOnly([
          "uid", "role", "plan", "watchlistLimit", "cooldownDays",
          "createdAt", "updatedAt"
        ])
        && data.keys().hasAll([
          "uid", "role", "plan", "watchlistLimit", "cooldownDays",
          "createdAt", "updatedAt"
        ])
        && data.uid is string
        && data.uid == uid
        && data.role == "client"
        && data.plan == "free"
        && data.watchlistLimit == 10
        && data.cooldownDays == 7
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validAdminEntitlement(data, uid) {
      return data.keys().hasOnly([
          "uid", "role", "plan", "watchlistLimit", "cooldownDays",
          "createdAt", "updatedAt"
        ])
        && data.keys().hasAll([
          "uid", "role", "plan", "watchlistLimit", "cooldownDays",
          "createdAt", "updatedAt"
        ])
        && data.uid is string
        && data.uid == uid
        && data.role == "admin"
        && data.plan == "pro"
        && data.watchlistLimit == 100
        && data.cooldownDays == 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Complimentary Pro: client role, full Pro limits, no payment.
    // Only the bootstrap admin may write this shape. Recipients may later
    // stamp giftAckedAt after they dismiss the gift notice.
    // `source` is optional so older admin clients can still grant Pro.
    function validCompProEntitlement(data, uid) {
      return data.keys().hasOnly([
          "uid", "role", "plan", "watchlistLimit", "cooldownDays",
          "createdAt", "updatedAt", "source", "giftAckedAt", "giftedAt"
        ])
        && data.keys().hasAll([
          "uid", "role", "plan", "watchlistLimit", "cooldownDays",
          "createdAt", "updatedAt"
        ])
        && data.uid is string
        && data.uid == uid
        && data.role == "client"
        && data.plan == "pro"
        && data.watchlistLimit == 100
        && data.cooldownDays == 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (
          !data.keys().hasAny(["source"])
          || data.source == "comp"
        )
        && (
          !data.keys().hasAny(["giftAckedAt"])
          || data.giftAckedAt is timestamp
        )
        && (
          !data.keys().hasAny(["giftedAt"])
          || data.giftedAt is timestamp
        );
    }

    function allowedSymbols() {
      // Keep in sync with YAHOO_SCAN_UNIVERSE in src/lib/watchlist-symbols.ts
      return [
        "A", "AAPL", "ABBV", "ABNB", "ABT", "ACGL", "ACN", "ADBE",
        "ADI", "ADM", "ADP", "ADSK", "AEE", "AEP", "AES", "AFL",
        "AIG", "AIZ", "AJG", "AKAM", "ALB", "ALGN", "ALL", "ALLE",
        "AMAT", "AMCR", "AMD", "AME", "AMGN", "AMP", "AMT", "AMZN",
        "ANET", "ANSS", "AON", "AOS", "APA", "APD", "APH", "APTV",
        "ARE", "ARM", "ATO", "AVB", "AVGO", "AVY", "AWK", "AXON",
        "AXP", "AZO", "BA", "BAC", "BALL", "BAX", "BBWI", "BBY",
        "BDX", "BEN", "BF-B", "BIIB", "BK", "BKNG", "BKR", "BLDR",
        "BLK", "BMY", "BR", "BRK-B", "BRO", "BSX", "BWA", "BX",
        "BXP", "C", "CAG", "CAH", "CARR", "CAT", "CB", "CBOE",
        "CBRE", "CCI", "CCL", "CDNS", "CDW", "CE", "CEG", "CF",
        "CFG", "CHD", "CHRW", "CHTR", "CI", "CINF", "CL", "CLX",
        "CMCSA", "CME", "CMG", "CMI", "CMS", "CNC", "CNP", "COF",
        "COIN", "COO", "COP", "COR", "COST", "CPAY", "CPB", "CPRT",
        "CPT", "CRL", "CRM", "CSCO", "CSGP", "CSX", "CTAS", "CTLT",
        "CTRA", "CTSH", "CTVA", "CVS", "CVX", "CZR", "D", "DAL",
        "DAY", "DD", "DE", "DFS", "DG", "DGX", "DHI", "DHR",
        "DIS", "DLR", "DLTR", "DOC", "DOV", "DOW", "DPZ", "DRI",
        "DTE", "DUK", "DVA", "DVN", "DXCM", "EA", "EBAY", "ECL",
        "ED", "EFX", "EG", "EIX", "EL", "ELV", "EMN", "EMR",
        "ENPH", "EOG", "EPAM", "EQIX", "EQR", "EQT", "ES", "ESS",
        "ETN", "ETR", "ETSY", "EVRG", "EW", "EXC", "EXPD", "EXPE",
        "EXR", "F", "FANG", "FAST", "FCX", "FDS", "FDX", "FE",
        "FFIV", "FI", "FICO", "FIS", "FITB", "FLT", "FMC", "FOX",
        "FOXA", "FRT", "FSLR", "FTNT", "FTV", "GD", "GDDY", "GE",
        "GEHC", "GEN", "GEV", "GILD", "GIS", "GL", "GLW", "GM",
        "GNRC", "GOOG", "GOOGL", "GPC", "GPN", "GRMN", "GS", "GWW",
        "HAL", "HAS", "HBAN", "HCA", "HD", "HES", "HIG", "HII",
        "HLT", "HOLX", "HON", "HOOD", "HPE", "HPQ", "HRL", "HSIC",
        "HST", "HSY", "HUBB", "HUM", "HWM", "IBM", "ICE", "IDXX",
        "IEX", "IFF", "INCY", "INTC", "INTU", "INVH", "IP", "IPG",
        "IQV", "IR", "IRM", "ISRG", "IT", "ITW", "IVZ", "J",
        "JBHT", "JBL", "JCI", "JKHY", "JNJ", "JNPR", "JPM", "K",
        "KDP", "KEY", "KEYS", "KHC", "KIM", "KKR", "KLAC", "KMB",
        "KMI", "KMX", "KO", "KR", "KVUE", "L", "LDOS", "LEN",
        "LH", "LHX", "LIN", "LKQ", "LLY", "LMT", "LNT", "LOW",
        "LRCX", "LULU", "LUV", "LVS", "LW", "LYB", "LYV", "MA",
        "MAA", "MAR", "MAS", "MCD", "MCHP", "MCK", "MCO", "MDLZ",
        "MDT", "MET", "META", "MGM", "MHK", "MKC", "MKTX", "MLM",
        "MMC", "MMM", "MNST", "MO", "MOH", "MOS", "MPC", "MPWR",
        "MRK", "MRNA", "MRO", "MS", "MSCI", "MSFT", "MSI", "MSTR",
        "MTB", "MTCH", "MTD", "MU", "NCLH", "NDAQ", "NDSN", "NEE",
        "NEM", "NFLX", "NI", "NKE", "NOC", "NOW", "NRG", "NSC",
        "NTAP", "NTRS", "NUE", "NVDA", "NVR", "NWS", "NWSA", "NXPI",
        "O", "ODFL", "OKE", "OMC", "ON", "ORCL", "ORLY", "OTIS",
        "OXY", "PANW", "PARA", "PAYC", "PAYX", "PCAR", "PCG", "PEG",
        "PEP", "PFE", "PFG", "PG", "PGR", "PH", "PHM", "PKG",
        "PLD", "PLTR", "PM", "PNC", "PNR", "PNW", "PODD", "POOL",
        "PPG", "PPL", "PRU", "PSA", "PSX", "PTC", "PWR", "PYPL",
        "QCOM", "QRVO", "RCL", "REG", "REGN", "RF", "RIVN", "RJF",
        "RL", "RMD", "ROK", "ROL", "ROP", "ROST", "RSG", "RTX",
        "RVTY", "SBAC", "SBUX", "SCHW", "SHOP", "SHW", "SJM", "SLB",
        "SMCI", "SNA", "SNPS", "SO", "SOFI", "SOLV", "SPG", "SPGI",
        "SRE", "STE", "STLD", "STT", "STX", "STZ", "SWK", "SWKS",
        "SYF", "SYK", "SYY", "T", "TAP", "TDG", "TDY", "TECH",
        "TEL", "TER", "TFC", "TFX", "TGT", "TJX", "TMO", "TMUS",
        "TPR", "TRGP", "TRMB", "TROW", "TRV", "TSCO", "TSLA", "TSN",
        "TT", "TTWO", "TXN", "TXT", "TYL", "UAL", "UBER", "UDR",
        "UHS", "ULTA", "UNH", "UNP", "UPS", "URI", "USB", "V",
        "VICI", "VLO", "VLTO", "VMC", "VRSK", "VRSN", "VRTX", "VST",
        "VTR", "VTRS", "VZ", "WAB", "WAT", "WBA", "WBD", "WDC",
        "WEC", "WELL", "WFC", "WM", "WMB", "WMT", "WRB", "WST",
        "WTW", "WY", "WYNN", "XEL", "XOM", "XYL", "YUM", "ZBH",
        "ZBRA", "ZTS"
      ];
    }

    function validSymbols(symbols, uid) {
      return symbols is list
        && symbols.size() <= effectiveWatchlistLimit(uid)
        && symbols.toSet().size() == symbols.size()
        && symbols.toSet().hasOnly(allowedSymbols());
    }

    function validWatchlist(data, uid) {
      return data.keys().hasOnly([
          "uid", "symbols", "changedAt", "nextChangeAt",
          "createdAt", "updatedAt"
        ])
        && data.keys().hasAll([
          "uid", "symbols", "changedAt", "nextChangeAt",
          "createdAt", "updatedAt"
        ])
        && data.uid is string
        && data.uid == uid
        && hasEntitlement(uid)
        && validSymbols(data.symbols, uid)
        && data.changedAt is timestamp
        && data.nextChangeAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Empty the list after Pro is removed, or when a free account is already
    // over the 10-name cap. nextChangeAt == now so they can add a free list.
    function validWatchlistReset(data, uid) {
      return data.keys().hasOnly([
          "uid", "symbols", "changedAt", "nextChangeAt",
          "createdAt", "updatedAt"
        ])
        && data.keys().hasAll([
          "uid", "symbols", "changedAt", "nextChangeAt",
          "createdAt", "updatedAt"
        ])
        && data.uid is string
        && data.uid == uid
        && data.symbols is list
        && data.symbols.size() == 0
        && data.changedAt == request.time
        && data.nextChangeAt == request.time
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function validFreeCooldown(data) {
      return data.nextChangeAt >= request.time + duration.value(167, "h")
        && data.nextChangeAt <= request.time + duration.value(169, "h");
    }

    function validProCooldown(data) {
      return data.nextChangeAt >= request.time
        && data.nextChangeAt <= request.time + duration.value(5, "m");
    }

    function validPortfolio(data, uid) {
      return data.keys().hasOnly([
          "uid", "cash", "totalValue", "createdAt", "updatedAt"
        ])
        && data.keys().hasAll([
          "uid", "cash", "totalValue", "createdAt", "updatedAt"
        ])
        && data.uid is string
        && data.uid == uid
        && data.cash is number
        && data.cash >= 0
        && data.cash <= 1000000000000
        && data.totalValue is number
        && data.totalValue >= 0
        && data.totalValue <= 1000000000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validHorizonSim(data, uid) {
      return data.keys().hasOnly([
          "uid", "cash", "totalValue", "createdAt", "updatedAt"
        ])
        && data.keys().hasAll([
          "uid", "cash", "totalValue", "createdAt", "updatedAt"
        ])
        && data.uid is string
        && data.uid == uid
        && data.cash is number
        && data.cash >= 0
        && data.cash <= 10000000
        && data.totalValue is number
        && data.totalValue >= 0
        && data.totalValue <= 10000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validHorizonSimCreate(data, uid) {
      return validHorizonSim(data, uid)
        && data.cash == 10000
        && data.totalValue == 10000;
    }

    function validPredictCount(value) {
      return value is number && value >= 0 && value <= 100;
    }

    function validPredictUsage(data, uid) {
      return data.keys().hasOnly([
          "uid", "weekId", "review", "horizon", "pulse", "score",
          "addition", "advanced", "updatedAt"
        ])
        && data.keys().hasAll(["uid", "weekId", "updatedAt"])
        && data.uid is string
        && data.uid == uid
        && data.weekId is string
        && data.weekId.size() >= 6
        && data.weekId.size() <= 16
        && (!("review" in data) || validPredictCount(data.review))
        && (!("horizon" in data) || validPredictCount(data.horizon))
        && (!("pulse" in data) || validPredictCount(data.pulse))
        && (!("score" in data) || validPredictCount(data.score))
        && (!("addition" in data) || validPredictCount(data.addition))
        && (!("advanced" in data) || validPredictCount(data.advanced))
        && data.updatedAt is timestamp;
    }

    function validPurchasedAt(value) {
      return value == null
        || (
          value is string
          && value.size() == 10
          && value.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        );
    }

    function validPosition(data, uid, symbol) {
      return data.keys().hasOnly([
          "uid", "symbol", "shares", "averageCost", "currentPrice",
          "updatedAt", "purchasedAt"
        ])
        && data.keys().hasAll([
          "uid", "symbol", "shares", "averageCost", "currentPrice", "updatedAt"
        ])
        && data.uid is string
        && data.uid == uid
        && data.symbol is string
        && data.symbol == symbol
        && data.symbol.matches("^[A-Z.\\-]{1,8}$")
        && data.shares is number
        && data.shares >= 0
        && data.shares <= 1000000000
        && data.averageCost is number
        && data.averageCost >= 0
        && data.averageCost <= 10000000
        && data.currentPrice is number
        && data.currentPrice >= 0
        && data.currentPrice <= 10000000
        && data.updatedAt is timestamp
        && (
          !data.keys().hasAny(["purchasedAt"])
          || validPurchasedAt(data.purchasedAt)
        );
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isBootstrapAdmin();
      allow create: if isOwner(uid)
        && validUser(request.resource.data, uid)
        && request.resource.data.keys().hasAll([
          "tosVersion", "tosAcceptedAt", "privacyAcceptedAt"
        ])
        && (
          isBootstrapAdmin()
          || request.resource.data.keys().hasAll(["firstName", "lastName"])
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid)
        && validUser(request.resource.data, uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && newSeenFrozen(resource.data, request.resource.data)
        && (
          !resource.data.keys().hasAny(["tosVersion"])
          || (
            request.resource.data.tosVersion == resource.data.tosVersion
            && request.resource.data.tosAcceptedAt == resource.data.tosAcceptedAt
            && request.resource.data.privacyAcceptedAt == resource.data.privacyAcceptedAt
          )
        );
      allow delete: if false;
    }

    match /entitlements/{uid} {
      allow read: if isOwner(uid) || isBootstrapAdmin();
      allow create: if isOwner(uid)
        && (
          (
            validFreeEntitlement(request.resource.data, uid)
            && request.auth.token.email != "admin@tvm-investments.test"
          )
          ||
          (
            isBootstrapAdmin()
            && validAdminEntitlement(request.resource.data, uid)
          )
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (
          isBootstrapAdmin()
          && (
            validFreeEntitlement(request.resource.data, uid)
            || validCompProEntitlement(request.resource.data, uid)
            || (
              validAdminEntitlement(request.resource.data, uid)
              && resource.data.role == "admin"
            )
          )
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
        )
        || (
          isOwner(uid)
          && resource.data.plan == "pro"
          && resource.data.role == "client"
          && (
            !resource.data.keys().hasAny(["source"])
            || resource.data.source == "comp"
          )
          && !resource.data.keys().hasAny(["giftAckedAt"])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["giftAckedAt", "updatedAt"])
          && request.resource.data.giftAckedAt is timestamp
          && request.resource.data.updatedAt == request.time
          && validCompProEntitlement(request.resource.data, uid)
        );
      allow delete: if false;
    }

    match /watchlists/{uid} {
      allow read: if isOwner(uid) || isBootstrapAdmin();
      allow create: if isOwner(uid)
        && validWatchlist(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.changedAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (isPaid(uid) && validProCooldown(request.resource.data))
          || (!isPaid(uid) && validFreeCooldown(request.resource.data))
        );
      allow update: if (
          isOwner(uid)
          && validWatchlist(request.resource.data, uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.changedAt == request.time
          && request.resource.data.updatedAt == request.time
          && (
            (
              isPaid(uid)
              && validProCooldown(request.resource.data)
            )
            ||
            (
              !isPaid(uid)
              && request.time >= resource.data.nextChangeAt
              && validFreeCooldown(request.resource.data)
            )
          )
        )
        || (
          isBootstrapAdmin()
          && validWatchlistReset(request.resource.data, uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt
        )
        || (
          isOwner(uid)
          && !isPaid(uid)
          && resource.data.symbols.size() > entitlement(uid).watchlistLimit
          && validWatchlistReset(request.resource.data, uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt
        );
      allow delete: if false;
    }

    match /portfolios/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && validPortfolio(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid)
        && validPortfolio(request.resource.data, uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /positions/{symbol} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validPosition(request.resource.data, uid, symbol)
          && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid);
      }
    }

    match /horizon_sims/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && validHorizonSimCreate(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid)
        && validHorizonSim(request.resource.data, uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /positions/{symbol} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validPosition(request.resource.data, uid, symbol)
          && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid);
      }
    }

    match /predict_usage/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && validPredictUsage(request.resource.data, uid)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Daily API proxy counters. Admin SDK only — clients must not read or write.
    match /api_usage/{uid} {
      allow read, write: if false;
    }

    match /beta_status/{uid} {
      allow read: if isOwner(uid) || isBootstrapAdmin();
      allow write: if false;
    }

    match /site/maintenance {
      allow read: if true;
      allow write: if false;
    }

    match /site/releases {
      allow read: if true;
      allow write: if false;
    }

    match /daily_snapshots/{document=**} {
      allow read, write: if false;
    }

    match /backtest_entries/{document=**} {
      allow read, write: if false;
    }

    match /user_investments/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
