{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "edition": "enterprise",
    "database": "tvm-investments",
    "location": "us-east1"
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "emulators": {
